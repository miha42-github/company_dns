# One profile per line, like /etc/passwd:   profile:sha256-of-the-token
# This is the only secret file. Make a token for a client and the hash to put here:
#   TOKEN=$(openssl rand -hex 32)                           # give this to the client, once
#   printf '%s' "$TOKEN" | shasum -a 256 | cut -d' ' -f1    # put this on the line
# The hashes below are placeholders (all zeros): no token matches them.
