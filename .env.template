# Copy this file to .env (gitignored) and fill in the values you need.
# Nothing here is required to just run `python3 company_dns.py` or the
# Docker image locally with defaults - only set what your workflow needs.

# Required by scripts/build-and-deploy.sh to push images to GHCR.
# Needs the write:packages scope. Not needed for local dev or `svc_ctl.sh`.
GITHUB_PAT=

# Selects dev-only behavior in company_dns.py (e.g. relaxed host checks).
# Leave unset for production-like behavior; the Docker image sets this to
# "production" itself (see Dockerfile).
# ENVIRONMENT=dev

# Log verbosity for lib/logging_config.py. Default: INFO.
# LOG_LEVEL=INFO

# When "true", includes extra debug headers in responses (lib/logging_config.py).
# Default: false. Don't enable in production.
# DEBUG_HEADERS=false

# Backing store for SlowAPI rate limiting (lib/rate_limiter.py).
# Default: in-memory, per-process. Set to a shared store (e.g. Redis URI)
# if running multiple workers/replicas that should share rate-limit state.
# RATE_LIMIT_STORAGE_URI=memory://
