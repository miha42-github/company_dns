experiments/embed-bench/embedding_texts.txt

# fastembed-rs's downloaded ONNX model weights (~600MB for 3 models) -
# never commit, re-downloaded automatically on first run
experiments/embed-bench/.fastembed_cache/
experiments/ic-similarity-service/.fastembed_cache/